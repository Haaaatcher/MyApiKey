{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyApiKey",
  "version": "1.0.0",
  "identifier": "com.haaaatcher.myapikey",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MyApiKey",
        "width": 980,
        "height": 700,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Haaaatcher/MyApiKey/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFQzgwNEJBQTdCQjQ2NzgKUldSNFJydW51Z1RJam5lUUZDVHFxeXE5MDlleVZTRXBwRXh6S2x6RWtDT3NCbnNIL0N4eUJsYjAK"
    }
  }
}